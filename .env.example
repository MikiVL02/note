# ── 基础 ──────────────────────────────────────────────
# JWT 签名密钥，生产环境必须换成随机长串
JWT_SECRET=change-this-to-a-random-secret
# 邮件发信密码（邀请码邮件），未配置时激活邮件会跳过发送
EMAIL_PASS=
# Claude API Key（AI 笔记功能），也可在站内「模型设置」里配置
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── 与简历站（resume）联动 ─────────────────────────────
# 简历站地址，激活成功后会把用户名推过去开通简历账号
RESUME_URL=https://resume.mikivl.online
# 本服务与简历站之间的共享密钥，两端必须一致
INTERNAL_SECRET=change-this-to-a-random-secret

# ── OAuth2 服务端（简历站通过它单点登录到笔记站）─────────
OAUTH_CLIENT_ID=resume-app
OAUTH_CLIENT_SECRET=change-this-to-a-random-secret
# 允许的回调地址前缀，逗号分隔；留空表示不校验
OAUTH_ALLOWED_REDIRECT_URIS=https://resume.mikivl.online
